{
  "name": "@anizoptera/publish-clean",
  "version": "0.1.0",
  "description": "Publish pnpm workspace packages from a cleaned, validated package tarball.",
  "license": "Apache-2.0",
  "author": "Anizoptera",
  "contributors": [
    "Art Shendrik"
  ],
  "homepage": "https://github.com/Anizoptera/publish-clean#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anizoptera/publish-clean.git"
  },
  "bugs": {
    "url": "https://github.com/Anizoptera/publish-clean/issues"
  },
  "keywords": [
    "npm",
    "publish",
    "pnpm",
    "pack",
    "package",
    "cleanup",
    "monorepo",
    "bun"
  ],
  "type": "module",
  "sideEffects": false,
  "bin": {
    "publish-clean": "./dist/cli.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "prepublishOnly": "pnpm run build && node dist/cli.js --guard-only",
    "build:tsc": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "check": "bun run format:check && bun run claude-link:check && bun run typecheck && bun run build && bun run test:built && bun run tracked-artifacts:check && bun run cleaned-artifact:check",
    "cleaned-artifact:check": "bun scripts/check-cleaned-artifact.ts",
    "claude-link:check": "test -L CLAUDE.md && test \"$(readlink CLAUDE.md)\" = AGENTS.md",
    "clean": "rm -rf ./dist ./node_modules/.cache",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "publish:clean": "bun run check && node dist/cli.js -- --access public --tag latest --provenance",
    "test": "bun run build && bun run test:built",
    "test:built": "vitest run  && bun test test/*.bun.test.ts",
    "tracked-artifacts:check": "test -z \"$(git ls-files dist)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "prettier": "^3.8.3",
    "publint": "^0.3.21",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20"
  },
  "browserslist": [
    "node >= 24"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
