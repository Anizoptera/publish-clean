{
  "name": "@anizoptera/publish-clean",
  "version": "0.4.0",
  "description": "Pre-publish npm package cleaner that strips common useless noise and crap from package.json; prevents accidental publication of unwanted things and unresolved dependencies. No deps, one JS file.",
  "keywords": [
    "bun",
    "cleanup",
    "monorepo",
    "npm",
    "pack",
    "package",
    "package.json",
    "pnpm",
    "provenance",
    "publish",
    "supply-chain",
    "workspace"
  ],
  "homepage": "https://github.com/Anizoptera/publish-clean#readme",
  "bugs": {
    "url": "https://github.com/Anizoptera/publish-clean/issues"
  },
  "license": "Apache-2.0",
  "author": "Anizoptera",
  "contributors": [
    "Art Shendrik"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anizoptera/publish-clean.git"
  },
  "bin": {
    "publish-clean": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "prepublishOnly": "pnpm run build && node dist/cli.js --guard-only",
    "check": "bun run format:check && bun run claude-link:check && bun run typecheck && bun run build && bun run test:built && bun run tracked-artifacts:check && bun run cleaned-artifact:check",
    "cleaned-artifact:check": "bun scripts/check-cleaned-artifact.ts",
    "claude-link:check": "test -L CLAUDE.md && test \"$(readlink CLAUDE.md)\" = AGENTS.md",
    "clean": "rm -rf ./dist ./node_modules/.cache",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "bun run build && bun run test:built",
    "test:built": "vitest run && bun test test/*.bun.test.ts",
    "tracked-artifacts:check": "test -z \"$(git ls-files dist)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "oxfmt": "^0.63.0",
    "pnpm": "^11.21.0",
    "publint": "^0.3.23",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
